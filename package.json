{
  "name": "@seasyecn/opencode-openai-residency-enhance",
  "version": "2.0.0",
  "description": "OpenCode plugin: OpenAI Codex data residency header, UA override, and WebSocket transport with local config fallback",
  "license": "MIT",
  "author": "SeasyecN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeasyecN/opencode-openai-residency-enhance.git"
  },
  "homepage": "https://github.com/SeasyecN/opencode-openai-residency-enhance#readme",
  "bugs": {
    "url": "https://github.com/SeasyecN/opencode-openai-residency-enhance/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "openai",
    "codex",
    "residency",
    "enterprise",
    "plugin"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.30"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
